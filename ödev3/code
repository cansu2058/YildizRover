from roboflow import Roboflow
from ultralytics import YOLO

rf = Roboflow(api_key="ceek1vSeDFmsc0QOM8Xd")

project = rf.workspace("cansus-workspace-fdmwe").project("stop_sign-bnovt")
version = project.version(1)

dataset = version.download("yolov11")

print("Dataset konumu:", dataset.location)

model = YOLO("yolo11n.pt")

model.train(
    data=dataset.location + "/data.yaml",
    epochs=50,
    imgsz=640,
    batch=4,
    optimizer="AdamW",
    lr0=0.001
)

best_model = YOLO("/content/runs/detect/train-3/weights/best.pt")
print(best_model)

from google.colab import drive
